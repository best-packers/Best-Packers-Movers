<!-- Breadcrumb -->
<div class="bg-slate-100 border-b border-slate-200 py-2 px-4">
  <div class="max-w-7xl mx-auto">
    <nav class="flex items-center text-xs text-slate-500 gap-1.5">
      <a href="/" class="hover:text-brand-orange transition">Home</a>
      <i class="fa-solid fa-chevron-right text-[9px] text-slate-400"></i>
      <a href="/blog" class="hover:text-brand-orange transition">Blog</a>
      <i class="fa-solid fa-chevron-right text-[9px] text-slate-400"></i>
      <span class="text-slate-700 font-medium truncate max-w-xs"><%= blog.title %></span>
    </nav>
  </div>
</div>

<div class="bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col lg:flex-row gap-10 items-start">

      <!-- Main Article -->
      <article class="flex-1 min-w-0">
        <!-- Category + Meta -->
        <div class="flex items-center gap-3 mb-4">
          <span class="text-[11px] font-bold uppercase tracking-wider text-brand-orange bg-orange-50 border border-orange-100 px-2.5 py-0.5 rounded-full"><%= blog.category %></span>
          <% if (blog.read_time_mins) { %>
            <span class="text-xs text-slate-400"><i class="fa-regular fa-clock mr-1"></i><%= blog.read_time_mins %> min read</span>
          <% } %>
          <span class="text-xs text-slate-400"><i class="fa-regular fa-calendar mr-1"></i><%= new Date(blog.created_at).toLocaleDateString('en-IN', {day:'numeric', month:'long', year:'numeric'}) %></span>
        </div>

        <!-- Title -->
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight mb-5"><%= blog.title %></h1>

        <!-- Cover Image -->
        <% if (blog.cover_image_url) { %>
          <div class="w-full rounded-2xl overflow-hidden mb-8 border border-slate-200 shadow-sm">
            <img src="<%= blog.cover_image_url %>" alt="<%= blog.title %>" class="w-full object-cover max-h-96" loading="eager">
          </div>
        <% } %>

        <!-- Article Body -->
        <div class="prose prose-slate max-w-none text-sm sm:text-base leading-relaxed blog-body">
          <%- blog.body_html || '<p>Article content coming soon.</p>' %>
        </div>

        <!-- FAQ Section -->
        <% 
          let faqs = [];
          try { faqs = JSON.parse(blog.faqs_json || '[]'); } catch(e) {}
        %>
        <% if (faqs && faqs.length > 0) { %>
          <div class="mt-10 border-t border-slate-200 pt-8">
            <h2 class="text-xl font-extrabold text-slate-900 mb-6 flex items-center">
              <i class="fa-solid fa-circle-question text-brand-orange mr-2.5"></i> Frequently Asked Questions
            </h2>
            <div class="space-y-3" id="faq-accordion">
              <% faqs.forEach((faq, i) => { %>
                <div class="border border-slate-200 rounded-xl overflow-hidden">
                  <button onclick="toggleFaq(this)" class="w-full flex items-center justify-between p-4 text-left bg-slate-50 hover:bg-slate-100 transition-colors">
                    <span class="text-sm font-bold text-slate-800 pr-4"><%= faq.question %></span>
                    <i class="fa-solid fa-plus text-brand-orange text-sm flex-shrink-0 transition-transform faq-icon"></i>
                  </button>
                  <div class="faq-body" style="display:none;">
                    <div class="p-4 text-sm text-slate-600 leading-relaxed border-t border-slate-100">
                      <%= faq.answer %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
          <!-- FAQPage Schema -->
          <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              <% faqs.forEach((faq, i) => { %>
              {
                "@type": "Question",
                "name": "<%= faq.question.replace(/"/g, '\\"') %>",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "<%= (faq.answer || '').replace(/"/g, '\\"') %>"
                }
              }<%= i < faqs.length - 1 ? ',' : '' %>
              <% }) %>
            ]
          }
          </script>
        <% } %>

        <!-- Related Articles -->
        <% if (related && related.length > 0) { %>
          <div class="mt-10 border-t border-slate-200 pt-8">
            <h2 class="text-lg font-extrabold text-slate-900 mb-5">Related Articles</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <% related.forEach(r => { %>
                <a href="/blog/<%= r.slug %>" class="group block bg-slate-50 border border-slate-200 rounded-xl overflow-hidden hover:border-brand-orange/40 transition">
                  <% if (r.cover_image_url) { %>
                    <div class="h-28 overflow-hidden">
                      <img src="<%= r.cover_image_url %>" alt="<%= r.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
                    </div>
                  <% } %>
                  <div class="p-3">
                    <p class="text-xs font-bold text-slate-800 leading-snug group-hover:text-brand-orange transition"><%= r.title %></p>
                  </div>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
      </article>

      <!-- Sidebar -->
      <aside class="w-full lg:w-72 shrink-0 lg:sticky lg:top-20 space-y-5">
        <!-- Quote CTA -->
        <div class="bg-gradient-to-br from-orange-500 to-orange-600 rounded-2xl p-5 text-white shadow-lg shadow-orange-500/25">
          <div class="text-center">
            <i class="fa-solid fa-truck-ramp-box text-3xl mb-3 block opacity-90"></i>
            <h3 class="font-extrabold text-base mb-1">Ready to Shift?</h3>
            <p class="text-orange-100 text-xs mb-4">Get free quotes from verified movers across India.</p>
            <button class="open-quote-btn w-full bg-white text-brand-orange font-bold py-2.5 rounded-xl text-sm hover:bg-orange-50 transition" data-vendor-id="0" data-vendor-name="National Packers & Movers">
              Get Free Quote
            </button>
          </div>
        </div>

        <!-- Recent Blogs -->
        <% if (related && related.length > 0) { %>
          <div class="bg-white border border-slate-200 rounded-2xl p-5">
            <h3 class="font-bold text-sm text-slate-800 mb-4 uppercase tracking-wide">More Guides</h3>
            <div class="space-y-4">
              <% related.forEach(r => { %>
                <a href="/blog/<%= r.slug %>" class="flex gap-3 group">
                  <% if (r.cover_image_url) { %>
                    <div class="w-16 h-14 rounded-lg overflow-hidden shrink-0">
                      <img src="<%= r.cover_image_url %>" alt="<%= r.title %>" class="w-full h-full object-cover" loading="lazy">
                    </div>
                  <% } %>
                  <p class="text-xs font-semibold text-slate-700 leading-snug group-hover:text-brand-orange transition"><%= r.title %></p>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
      </aside>

    </div>
  </div>
</div>

<!-- Article Schema.org -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "<%= blog.title.replace(/"/g, '\\"') %>",
  "description": "<%= (blog.excerpt || '').replace(/"/g, '\\"') %>",
  "image": "<%= blog.cover_image_url || '' %>",
  "datePublished": "<%= blog.created_at %>",
  "dateModified": "<%= blog.updated_at || blog.created_at %>",
  "publisher": {
    "@type": "Organization",
    "name": "BestPackersMovers",
    "logo": { "@type": "ImageObject", "url": "" }
  }
}
</script>

<script>
  function toggleFaq(btn) {
    const body = btn.nextElementSibling;
    const icon = btn.querySelector('.faq-icon');
    const isOpen = body.style.display !== 'none';
    body.style.display = isOpen ? 'none' : 'block';
    icon.style.transform = isOpen ? '' : 'rotate(45deg)';
  }
</script>

<style>
  .blog-body h1, .blog-body h2, .blog-body h3 { font-weight: 800; color: #0f172a; margin: 1.5em 0 0.75em; }
  .blog-body h2 { font-size: 1.25rem; }
  .blog-body h3 { font-size: 1.1rem; }
  .blog-body p { margin-bottom: 1em; color: #334155; line-height: 1.75; }
  .blog-body ul, .blog-body ol { margin: 1em 0 1em 1.5em; color: #334155; }
  .blog-body li { margin-bottom: 0.4em; }
  .blog-body blockquote { border-left: 4px solid #f97316; padding-left: 1rem; color: #64748b; margin: 1.5em 0; font-style: italic; }
  .blog-body strong { color: #0f172a; }
</style>
