      <div class="grid grid-cols-3 sm:grid-cols-6 gap-4">
        <button onclick="prefillSearch('Local House Shifting')" class="bg-white hover:bg-orange-50/50 p-4 rounded-2xl border border-slate-200 hover:border-brand-orange shadow-sm hover:shadow-md transition duration-150 flex flex-col items-center space-y-2.5 group">
          <div class="w-12 h-12 bg-orange-50 text-brand-orange rounded-xl flex items-center justify-center text-xl group-hover:scale-105 transition-transform"><i class="fa-solid fa-house-chimney"></i></div>
          <span class="text-[11px] font-bold text-slate-700 leading-tight text-center">Local House Shifting</span>
        </button>
        <button onclick="prefillSearch('Office Relocation')" class="bg-white hover:bg-orange-50/50 p-4 rounded-2xl border border-slate-200 hover:border-brand-orange shadow-sm hover:shadow-md transition duration-150 flex flex-col items-center space-y-2.5 group">
          <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-105 transition-transform"><i class="fa-solid fa-building"></i></div>
          <span class="text-[11px] font-bold text-slate-700 leading-tight text-center">Office Shifting</span>
        </button>
        <button onclick="prefillSearch('Car Transportation')" class="bg-white hover:bg-orange-50/50 p-4 rounded-2xl border border-slate-200 hover:border-brand-orange shadow-sm hover:shadow-md transition duration-150 flex flex-col items-center space-y-2.5 group">
          <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-105 transition-transform"><i class="fa-solid fa-car"></i></div>
          <span class="text-[11px] font-bold text-slate-700 leading-tight text-center">Car Carrier</span>
        </button>
        <button onclick="prefillSearch('Bike Shifting')" class="bg-white hover:bg-orange-50/50 p-4 rounded-2xl border border-slate-200 hover:border-brand-orange shadow-sm hover:shadow-md transition duration-150 flex flex-col items-center space-y-2.5 group">
          <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-105 transition-transform"><i class="fa-solid fa-motorcycle"></i></div>
          <span class="text-[11px] font-bold text-slate-700 leading-tight text-center">Bike Shifting</span>
        </button>
        <button onclick="prefillSearch('Warehouse Storage')" class="bg-white hover:bg-orange-50/50 p-4 rounded-2xl border border-slate-200 hover:border-brand-orange shadow-sm hover:shadow-md transition duration-150 flex flex-col items-center space-y-2.5 group">
          <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-105 transition-transform"><i class="fa-solid fa-warehouse"></i></div>
          <span class="text-[11px] font-bold text-slate-700 leading-tight text-center">Warehouse Storage</span>
        </button>
        <button onclick="prefillSearch('Domestic Relocation')" class="bg-white hover:bg-orange-50/50 p-4 rounded-2xl border border-slate-200 hover:border-brand-orange shadow-sm hover:shadow-md transition duration-150 flex flex-col items-center space-y-2.5 group">
          <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-xl group-hover:scale-105 transition-transform"><i class="fa-solid fa-truck-fast"></i></div>
          <span class="text-[11px] font-bold text-slate-700 leading-tight text-center">Intercity Moving</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Latest Blog Posts Section -->
<% if (latestBlogs && latestBlogs.length > 0) { %>
<div class="bg-slate-900 py-14 text-white border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <p class="text-xs font-bold text-brand-orange uppercase tracking-wider mb-1">From Our Blog</p>
        <h2 class="text-2xl font-extrabold text-white">Shifting Tips & Relocation Guides</h2>
      </div>
      <a href="/blog" class="hidden sm:flex items-center text-sm font-bold text-brand-orange hover:text-orange-400 transition">
        View All Articles <i class="fa-solid fa-chevron-right ml-1.5 text-xs"></i>
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <% latestBlogs.forEach(blog => { %>
        <article class="bg-slate-800/60 border border-slate-700/50 rounded-2xl overflow-hidden hover:border-brand-orange/40 hover:shadow-lg hover:shadow-orange-500/10 transition-all group">
          <% if (blog.cover_image_url) { %>
            <a href="/blog/<%= blog.slug %>">
              <div class="h-44 overflow-hidden">
                <img src="<%= blog.cover_image_url %>" alt="<%= blog.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
              </div>
            </a>
          <% } %>
          <div class="p-5 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-wider text-brand-orange bg-orange-500/10 px-2 py-0.5 rounded"><%= blog.category || 'Guide' %></span>
              <span class="text-[10px] text-slate-400"><%= blog.read_time_mins ? blog.read_time_mins + ' min read' : '' %></span>
            </div>
            <h3 class="text-sm font-bold text-white leading-snug">
              <a href="/blog/<%= blog.slug %>" class="hover:text-brand-orange transition-colors"><%= blog.title %></a>
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed line-clamp-2"><%= blog.excerpt %></p>
            <a href="/blog/<%= blog.slug %>" class="inline-flex items-center text-xs font-bold text-brand-orange hover:text-orange-400 transition pt-1">
              Read Article <i class="fa-solid fa-arrow-right ml-1.5 text-[10px]"></i>
            </a>
          </div>
        </article>
      <% }) %>
    </div>
    <div class="mt-6 text-center sm:hidden">
      <a href="/blog" class="inline-flex items-center text-sm font-bold text-brand-orange hover:text-orange-400 transition">
        View All Articles <i class="fa-solid fa-chevron-right ml-1.5 text-xs"></i>
      </a>
    </div>
  </div>
</div>
<% } %>

<!-- Premium Directory Highlight Section -->
<div class="py-16 sm:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">Explore States and Cities</h2>
      <p class="text-slate-500 text-sm">
        We serve a dense relocation network across key logistics corridors in Northern, Eastern, and Central India.
      </p>
    </div>

    <!-- States Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% states.forEach(state => { %>
        <% 
          // Find cities in this state
          const stateCities = cities.filter(c => c.state_id === state.id);
        %>
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200/60 hover:shadow-lg hover:border-slate-300 transition-all group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 bg-indigo-50 border border-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-location-arrow"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2"><%= state.name %></h3>
            <p class="text-slate-500 text-xs mb-6">
              Verified local and intercity transit logistics listings across <%= stateCities.length %> major cities.
            </p>
          </div>
          
          <div class="space-y-4">
            <div class="flex flex-wrap gap-2">
              <% stateCities.slice(0, 3).forEach(c => { %>
                <a href="/<%= c.slug %>" class="text-xs bg-white text-slate-600 font-bold px-2.5 py-1.5 rounded-lg border border-slate-200 hover:border-brand-orange hover:text-brand-orange transition">
                  <%= c.name %>
                </a>
              <% }) %>
              <% if (stateCities.length > 3) { %>
                <span class="text-xs text-slate-400 font-semibold px-2.5 py-1.5">+<%= stateCities.length - 3 %> more</span>
              <% } %>
            </div>
            <a href="/state/<%= state.slug %>" class="inline-flex items-center text-xs font-bold text-indigo-600 hover:text-brand-orange group transition-colors pt-2">
              <span>Explore State Directory</span>
              <i class="fa-solid fa-chevron-right text-[10px] ml-1.5 transform group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

