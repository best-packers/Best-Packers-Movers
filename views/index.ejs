<!-- Home Page View (Premium Dark Hero Theme) -->
<div class="relative bg-slate-900 overflow-hidden py-24 sm:py-32">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-brand-orange/10 blur-[120px] pointer-events-none"></div>
  <div class="absolute top-10 right-10 w-[300px] h-[300px] rounded-full bg-blue-500/5 blur-[80px] pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <div class="inline-flex items-center space-x-2 bg-slate-800/80 border border-slate-700/50 px-4 py-1.5 rounded-full text-xs font-semibold text-brand-orange animate-pulse-slow">
        <i class="fa-solid fa-circle-check text-xs"></i>
        <span>Verified Relocation Directory for 2026</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-none">
        Find Verified <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-orange to-orange-400">Packers & Movers</span> in India
      </h1>
      <p class="text-slate-400 text-base sm:text-xl leading-relaxed">
        Compare audited, high-rated relocation specialists in your city. Omit the stress and shield yourself from transit fraud with our verified directory listings.
      </p>

      <!-- Fast Directory Dropdown Selection -->
      <div class="max-w-xl mx-auto bg-white p-2 rounded-2xl shadow-xl flex flex-col sm:flex-row gap-2 mt-8 border border-slate-100">
        <div class="flex-grow flex items-center px-3 py-2 sm:py-0">
          <i class="fa-solid fa-map-location-dot text-slate-400 text-lg mr-3"></i>
          <select id="quick-city-select" class="w-full text-slate-700 bg-transparent text-sm focus:outline-none py-1 font-semibold">
            <option value="" disabled selected>Select your city to compare...</option>
            <% cities.forEach(city => { %>
              <option value="/<%= city.slug %>"><%= city.name %> (<%= city.state_name %>)</option>
            <% }) %>
          </select>
        </div>
        <button onclick="navigateCity()" class="bg-brand-orange hover:bg-orange-600 text-white font-bold px-8 py-3.5 rounded-xl shadow-md shadow-orange-500/20 active:scale-95 transition-all text-sm whitespace-nowrap">
          Compare Shifting Rates
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Quick Category Icons Grid Section -->
<div class="py-10 bg-slate-50 border-b border-slate-200/80">
