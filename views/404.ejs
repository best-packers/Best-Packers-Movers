<!-- 404 Page View -->
<div class="py-24 text-center space-y-6">
  <div class="w-20 h-20 bg-orange-100 text-brand-orange rounded-full flex items-center justify-center mx-auto shadow-md">
    <i class="fa-solid fa-triangle-exclamation text-3xl"></i>
  </div>
  <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">404 - Page Not Found</h1>
  <p class="text-slate-500 max-w-md mx-auto text-sm sm:text-base leading-relaxed">
    <%= typeof message !== 'undefined' ? message : 'The page you are looking for does not exist or has been relocated.' %>
  </p>
  <div class="pt-4">
    <a href="/" class="bg-brand-orange hover:bg-orange-600 text-white font-bold px-8 py-3.5 rounded-xl shadow-md shadow-orange-500/20 active:scale-95 transition-all text-sm inline-block">
      Return to Homepage
    </a>
  </div>
</div>
