<!-- Mobile Sticky Bottom Call Bar (Premium App UX) -->
<div class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 p-3 flex md:hidden gap-3 z-40 mobile-cta-sticky">
  <a href="tel:<%= vendor.phone %>" data-vendor-id="<%= vendor.id %>" class="gated-phone-link flex-grow bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 rounded-xl text-center text-xs flex items-center justify-center gap-2">
    <i class="fa-solid fa-phone"></i> Call Now
  </a>
