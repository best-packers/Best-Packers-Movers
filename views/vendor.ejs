                  <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
                    <span class="text-sm font-bold text-slate-800 group-open:text-brand-orange transition-colors"><%= faq.q %></span>
                    <span class="ml-1.5 flex-shrink-0 w-6 h-6 bg-white rounded-full flex items-center justify-center border border-slate-100 shadow-sm group-open:rotate-180 transition duration-300">
                      <i class="fa-solid fa-chevron-down text-xs text-slate-400 group-open:text-brand-orange"></i>
                    </span>
                  </summary>
                  <p class="text-xs text-slate-500 font-medium leading-relaxed mt-3 pt-3 border-t border-slate-100/60 transition-all duration-300">
                    <%= faq.a %>
                  </p>
                </details>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <!-- RIGHT Sticky Sidebar Column -->
      <div class="vendor-right-column w-full lg:w-1/3 space-y-6 lg:sticky lg:top-32">
        
        <!-- Interactive Sidebar Lead capture form widget -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-lg space-y-5">
          <div class="flex items-center space-x-3 pb-3 border-b border-slate-100">
            <div class="w-10 h-10 bg-orange-100 text-brand-orange rounded-xl flex items-center justify-center shrink-0">
              <i class="fa-solid fa-paper-plane text-lg"></i>
            </div>
            <div>
              <h3 class="font-extrabold text-slate-900 text-sm">Send Instant Enquiry</h3>
              <p class="text-[10px] text-slate-400 font-bold uppercase">Compare rates from <%= vendor.name %></p>
            </div>
          </div>
          
          <form id="sidebar-quote-form" class="space-y-4">
            <input type="hidden" id="sidebar-vendor-id" value="<%= vendor.id %>">
            
            <div>
              <label for="sidebar-from" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Moving From</label>
              <input type="text" id="sidebar-from" required placeholder="e.g. <%= city.name %>" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange transition text-xs font-semibold">
            </div>

            <div>
              <label for="sidebar-to" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Moving To</label>
              <input type="text" id="sidebar-to" required placeholder="e.g. Bangalore, Lucknow" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange transition text-xs font-semibold">
            </div>

