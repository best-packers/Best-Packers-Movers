        <!-- Detailed contact info list -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-4">
          <h3 class="font-extrabold text-xs text-slate-800 uppercase tracking-wider pb-2 border-b border-slate-100">Location Contacts</h3>
          
          <div class="space-y-4 text-xs font-semibold text-slate-600">
            <div class="space-y-1">
              <span class="text-slate-400 block">Office Address</span>
              <span class="text-slate-800 block leading-relaxed"><%= vendor.address %></span>
            </div>
            <div class="space-y-1">
              <span class="text-slate-400 block">Phone Support</span>
              <a href="tel:<%= vendor.phone %>" class="gated-phone-link text-indigo-600 hover:underline block text-sm font-bold" data-vendor-id="<%= vendor.id %>"><%= vendor.phone %></a>
            </div>
            <% if (vendor.website) { %>
              <div class="space-y-1">
                <span class="text-slate-400 block">Official Link</span>
                <a href="<%= vendor.website %>" target="_blank" class="gated-website-link text-indigo-600 hover:underline block" data-vendor-id="<%= vendor.id %>">Visit Corporate Site</a>
              </div>
