              <% if (typeof existingUserReview !== 'undefined' && existingUserReview) { %>
                <span class="bg-amber-100 text-amber-800 border border-amber-200 text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full flex items-center">
