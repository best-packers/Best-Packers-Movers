              <input type="tel" id="sidebar-phone" value="<%= userPhone || '' %>" required pattern="[0-9]{10}" placeholder="9876543210" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange transition text-xs font-semibold">
            </div>

            <div>
              <label for="sidebar-date" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Shifting Date (Optional)</label>
              <input type="date" id="sidebar-date" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-orange/20 focus:border-brand-orange transition text-xs font-semibold">
            </div>

            <button type="submit" class="w-full bg-brand-orange hover:bg-orange-600 text-white font-extrabold py-3.5 rounded-xl text-center shadow-lg shadow-orange-500/15 transition-all text-xs">
              Send Shifting Request &raquo;
            </button>
