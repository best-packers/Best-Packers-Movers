              <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Rating Star</label>
                <div class="flex items-center space-x-1.5 pt-1.5 text-slate-300 text-lg">
                  <% const initRating = (typeof existingUserReview !== 'undefined' && existingUserReview) ? existingUserReview.rating : 5; %>
