                  <button type="button" onclick="setStarRating(2)" class="star-btn <%= initRating >= 2 ? 'text-amber-400' : '' %>"><i class="fa-solid fa-star"></i></button>
                  <button type="button" onclick="setStarRating(3)" class="star-btn <%= initRating >= 3 ? 'text-amber-400' : '' %>"><i class="fa-solid fa-star"></i></button>
                  <button type="button" onclick="setStarRating(4)" class="star-btn <%= initRating >= 4 ? 'text-amber-400' : '' %>"><i class="fa-solid fa-star"></i></button>
                  <button type="button" onclick="setStarRating(5)" class="star-btn <%= initRating >= 5 ? 'text-amber-400' : '' %>"><i class="fa-solid fa-star"></i></button>
