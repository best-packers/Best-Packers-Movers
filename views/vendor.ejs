    <i class="fa-brands fa-whatsapp text-sm"></i> WhatsApp
  </a>
</div>

<!-- Lightbox Modal Element (Full Screen Images) -->
<div id="gallery-lightbox" class="fixed inset-0 bg-slate-950/90 backdrop-blur-sm z-50 items-center justify-center hidden p-4 animate-fade-in">
  <button id="close-lightbox" class="absolute top-4 right-4 text-white/70 hover:text-white hover:bg-white/10 p-2.5 rounded-full transition-all">
    <i class="fa-solid fa-xmark text-xl"></i>
  </button>
  <div class="max-w-4xl w-full flex flex-col items-center">
    <img id="lightbox-img" src="" alt="Full resolution view" class="max-h-[80vh] max-w-full object-contain rounded-xl shadow-2xl">
    <p id="lightbox-caption" class="text-white/90 text-sm font-semibold mt-4 text-center"></p>
  </div>
</div>

<!-- Script Blocks -->
<script>
  // Dynamic Scroll Sections
  function scrollToSection(id, element) {
    const el = document.getElementById(id);
    if (el) {
      el.scrollIntoView({ behavior: 'smooth' });
    }
    
    // Toggle active classes on click
    if (element) {
      document.querySelectorAll('.tab-item').forEach(tab => {
        tab.className = 'tab-item pb-2 hover:text-brand-orange transition shrink-0';
      });
      element.className = 'tab-item active-tab pb-2 hover:text-brand-orange transition shrink-0';
    }
  }

  // Gallery Pagination & Filters (v2.9)
  let currentGalleryPage = 0;
  let activeCategory = 'all';

  function updateGalleryDisplay() {
    const items = Array.from(document.querySelectorAll('.gallery-item-wrapper'));
    
    // Filter items by category
    const filteredItems = items.filter(item => {
      const type = item.getAttribute('data-uploaded-by');
      return activeCategory === 'all' || type === activeCategory;
    });

    // Hide all items initially
    items.forEach(item => {
      item.classList.add('hidden');
      item.classList.remove('block');
    });

    const itemsPerPage = 6;
    const totalFiltered = filteredItems.length;
    const totalPages = Math.ceil(totalFiltered / itemsPerPage) || 1;

    // Boundary safe checks
    if (currentGalleryPage >= totalPages) {
      currentGalleryPage = totalPages - 1;
    }
    if (currentGalleryPage < 0) {
      currentGalleryPage = 0;
    }

    // Show only the 6 items for the active page
    const startIdx = currentGalleryPage * itemsPerPage;
    const endIdx = startIdx + itemsPerPage;
    const itemsToShow = filteredItems.slice(startIdx, endIdx);

    itemsToShow.forEach(item => {
      item.classList.remove('hidden');
      item.classList.add('block');
    });

    // Update pagination controls text and button states
    const paginationEl = document.getElementById('gallery-pagination');
    if (paginationEl) {
      if (totalPages > 1) {
        paginationEl.classList.remove('hidden');
        paginationEl.classList.add('flex');
        
        document.getElementById('gallery-page-info').textContent = `Page ${currentGalleryPage + 1} of ${totalPages}`;
        document.getElementById('gallery-prev-btn').disabled = (currentGalleryPage === 0);
        document.getElementById('gallery-next-btn').disabled = (currentGalleryPage === totalPages - 1);
      } else {
        paginationEl.classList.remove('flex');
        paginationEl.classList.add('hidden');
      }
    }
  }

  function filterGallery(category, button) {
    document.querySelectorAll('.gallery-filter-btn').forEach(btn => {
      btn.className = 'gallery-filter-btn px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900';
    });
    button.className = 'gallery-filter-btn px-3 py-1.5 rounded-lg bg-white text-brand-orange shadow-sm';

    activeCategory = category;
    currentGalleryPage = 0; // reset page to index 0 on filter switch
    updateGalleryDisplay();
  }

  function changeGalleryPage(direction) {
    currentGalleryPage += direction;
    updateGalleryDisplay();
  }

  // Stars Setter
  let selectedStars = 1;
  function setStarRating(stars) {
    selectedStars = stars;
    document.getElementById('review-rating').value = stars;
    const buttons = document.querySelectorAll('.star-btn');
    buttons.forEach((btn, idx) => {
      if (idx < stars) {
        btn.className = 'star-btn text-amber-400';
      } else {
        btn.className = 'star-btn text-slate-300';
      }
    });
  }

  // Slider controls
  let currentReviewSlide = 0;
  const totalReviewSlides = <%= reviews.length %>;
  let reviewAutoPlayInterval = null;

  function showReviewSlide(index) {
    if (totalReviewSlides <= 1) return;
    
    if (index >= totalReviewSlides) {
      currentReviewSlide = 0;
    } else if (index < 0) {
      currentReviewSlide = totalReviewSlides - 1;
    } else {
      currentReviewSlide = index;
    }

    const slides = document.querySelectorAll('.review-slide-card');
    slides.forEach((slide, idx) => {
      if (idx === currentReviewSlide) {
        slide.classList.remove('hidden');
        slide.classList.add('block');
        setTimeout(() => {
          slide.style.opacity = '1';
        }, 20);
      } else {
        slide.style.opacity = '0';
        slide.classList.remove('block');
        slide.classList.add('hidden');
      }
    });

    const dots = document.querySelectorAll('.review-dot-indicator');
    dots.forEach((dot, idx) => {
      if (idx === currentReviewSlide) {
        dot.classList.add('active');
      } else {
        dot.classList.remove('active');
      }
    });
  }

  function changeReviewSlide(step) {
    showReviewSlide(currentReviewSlide + step);
  }

  function goToReviewSlide(index) {
    showReviewSlide(index);
  }

  function startReviewAutoPlay() {
    stopReviewAutoPlay();
    if (totalReviewSlides > 1) {
      reviewAutoPlayInterval = setInterval(() => {
        changeReviewSlide(1);
      }, 5000);
    }
  }

  function stopReviewAutoPlay() {
    if (reviewAutoPlayInterval) {
      clearInterval(reviewAutoPlayInterval);
    }
  }

  function manualChangeSlide(step) {
    changeReviewSlide(step);
    startReviewAutoPlay();
  }

  document.addEventListener('DOMContentLoaded', () => {
    startReviewAutoPlay();
    updateGalleryDisplay();

    // Setup review status label
    const loginLabel = document.getElementById('reviews-login-status');
    if (loginLabel) {
      if (window.isUserLoggedIn && window.userPhone) {
        const masked = window.userPhone.substring(0, 3) + '***' + window.userPhone.substring(6);
        loginLabel.innerHTML = `
          <div class="flex items-center space-x-2.5">
            <span class="text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-100 flex items-center gap-1.5"><i class="fa-solid fa-circle-check text-[10px]"></i> Verified +91 ${masked}</span>
            <a href="/logout" class="text-xs text-rose-600 hover:text-rose-700 font-bold hover:underline">Logout</a>
          </div>
        `;
      } else {
        loginLabel.innerHTML = `<button type="button" onclick="openOtpModal()" class="text-indigo-600 hover:text-indigo-700 hover:underline flex items-center gap-1"><i class="fa-solid fa-lock text-[10px]"></i> Phone Login</button>`;
      }
    }

    // Photo Lightbox Trigger
    document.querySelectorAll('.gallery-thumb').forEach(thumb => {
      thumb.addEventListener('click', function() {
        document.getElementById('lightbox-img').src = this.getAttribute('data-full');
        document.getElementById('lightbox-caption').textContent = this.getAttribute('data-caption');
        document.getElementById('gallery-lightbox').classList.remove('hidden');
        document.getElementById('gallery-lightbox').classList.add('flex');
      });
    });

    const closeBtn = document.getElementById('close-lightbox');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        document.getElementById('gallery-lightbox').classList.remove('flex');
        document.getElementById('gallery-lightbox').classList.add('hidden');
      });
    }

    // Phone calls action logger Gating
    document.querySelectorAll('.gated-phone-link').forEach(el => {
      el.addEventListener('click', function(e) {
        const targetHref = this.getAttribute('href');
        const vendorId = this.getAttribute('data-vendor-id');
        
        if (!window.isUserLoggedIn) {
          e.preventDefault();
          triggerOtpGate(() => {
            fetch('/api/log-action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action_type: 'call', vendor_id: vendorId })
            }).finally(() => {
              window.location.href = targetHref;
            });
          });
        } else {
          fetch('/api/log-action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action_type: 'call', vendor_id: vendorId })
          });
        }
      });
    });

    // Website Redirect logger Gating
    document.querySelectorAll('.gated-website-link').forEach(el => {
      el.addEventListener('click', function(e) {
        const targetHref = this.getAttribute('href');
        const vendorId = this.getAttribute('data-vendor-id');
        
        if (!window.isUserLoggedIn) {
          e.preventDefault();
          triggerOtpGate(() => {
            fetch('/api/log-action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action_type: 'website', vendor_id: vendorId, target_url: targetHref })
            }).finally(() => {
              window.open(targetHref, '_blank');
            });
          });
        } else {
          fetch('/api/log-action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action_type: 'website', vendor_id: vendorId, target_url: targetHref })
          });
        }
      });
    });

    // AJAX Shifting Lead Form Submission
    const sidebarForm = document.getElementById('sidebar-quote-form');
    if (sidebarForm) {
      sidebarForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitEnquiry = async () => {
          const submitBtn = sidebarForm.querySelector('button[type="submit"]');
          const originalText = submitBtn.textContent;
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending Request...';

          const requestData = {
            vendor_id: document.getElementById('sidebar-vendor-id').value,
            moving_from: document.getElementById('sidebar-from').value.trim(),
            moving_to: document.getElementById('sidebar-to').value.trim(),
            moving_date: document.getElementById('sidebar-date').value,
            phone: document.getElementById('sidebar-phone').value.trim()
          };

          try {
            const res = await fetch('/api/quote', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(requestData)
            });
            const data = await res.json();
            if (data.success) {
              alert(data.message || 'Enquiry request sent successfully!');
              sidebarForm.reset();
              if (window.isUserLoggedIn) {
                document.getElementById('sidebar-phone').value = window.userPhone;
              }
            } else {
              alert('Enquiry Failed: ' + data.message);
            }
          } catch(err) {
            console.error(err);
            alert('Connection failed. Please check network and try again.');
          } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          }
        };

        if (!window.isUserLoggedIn) {
          triggerOtpGate(() => {
            submitEnquiry();
          });
        } else {
          submitEnquiry();
        }
      });
    }

    // Review Submission Gate
    const rForm = document.getElementById('review-form');
    if (rForm) {
      rForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitReview = async () => {
          const submitBtn = rForm.querySelector('button[type="submit"]');
          const submitBtnSpan = submitBtn.querySelector('span');
          const originalText = submitBtnSpan.textContent;
          
          submitBtn.disabled = true;
          submitBtnSpan.textContent = 'Publishing...';

          const formData = {
            vendor_id: "<%= vendor.id %>",
            city_id: "<%= city.id %>",
            customer_name: document.getElementById('review-name').value.trim(),
            rating: document.getElementById('review-rating').value,
            review_text: document.getElementById('review-text').value.trim()
          };

          try {
            const res = await fetch('/api/review', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });
            const data = await res.json();
            if (data.success) {
              alert(data.message || 'Review submitted successfully!');
              rForm.reset();
              setStarRating(1);
              location.reload();
            } else {
              alert('Submission Error: ' + data.message);
            }
          } catch(err) {
            console.error(err);
            alert('Connection failed. Please try again.');
          } finally {
            submitBtn.disabled = false;
            submitBtnSpan.textContent = originalText;
          }
        };

        if (!window.isUserLoggedIn) {
          triggerOtpGate(() => {
            submitReview();
          });
        } else {
          submitReview();
        }
      });
    }
  });
</script>
