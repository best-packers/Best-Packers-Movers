<!-- Premium Style Override for World-Class Aesthetic -->
<style>
  .hero-dark-gradient {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%) !important;
  }
  .sticky-tab-bar {
    position: sticky;
    top: 64px;
    z-index: 30;
    backdrop-filter: blur(12px) !important;
    background-color: rgba(255, 255, 255, 0.85) !important;
    border-bottom: 1px solid rgba(226, 232, 240, 0.8) !important;
  }
  .active-tab {
    color: #f97316 !important;
    border-bottom: 3px solid #f97316 !important;
  }
  .glass-card {
    background-color: #ffffff !important;
    border: 1px solid rgba(226, 232, 240, 0.8) !important;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05) !important;
    transition: all 0.3s ease !important;
  }
  .glass-card:hover {
    box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.08) !important;
    transform: translateY(-2px);
  }
  .ratings-breakdown-bar {
    background-color: #f1f5f9 !important;
    height: 6px !important;
    border-radius: 9999px !important;
    overflow: hidden !important;
  }
  .ratings-breakdown-fill {
    background: linear-gradient(to right, #f59e0b, #f97316) !important;
    height: 100% !important;
  }
  .mobile-cta-sticky {
    box-shadow: 0 -10px 25px -5px rgba(15, 23, 42, 0.15) !important;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @media (min-width: 1024px) {
    .vendor-main-container {
      display: flex !important;
      flex-direction: row !important;
      gap: 32px !important;
      align-items: flex-start !important;
    }
    .vendor-left-column {
      width: 66% !important;
      flex-shrink: 0 !important;
    }
    .vendor-right-column {
      width: 34% !important;
      flex-shrink: 0 !important;
      position: sticky !important;
      top: 130px !important;
    }
  }
</style>

<!-- Premium Hero Header -->
<div class="relative hero-dark-gradient border-b border-slate-800/80 text-white overflow-hidden">
  <!-- Banner Backdrop -->
  <% if (vendor.banner_url) { %>
    <div class="absolute inset-0 w-full h-full overflow-hidden bg-slate-950">
      <img src="<%= vendor.banner_url %>" alt="<%= vendor.name %> Banner" class="w-full h-full object-cover opacity-85">
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/30"></div>
    </div>
  <% } else { %>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-orange-600/10 via-indigo-950/20 to-slate-950 opacity-40"></div>
  <% } %>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-36 pb-10 z-10">
    <!-- Breadcrumbs -->
    <nav class="flex space-x-2 text-xs font-semibold text-slate-400 mb-6">
      <a href="/" class="hover:text-white transition">Home</a>
      <span>/</span>
      <a href="/<%= city.slug %>" class="hover:text-white transition"><%= city.name %></a>
      <span>/</span>
      <span class="text-brand-orange"><%= vendor.name %></span>
    </nav>

    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
      <div class="flex flex-row items-center gap-4 sm:gap-6">
        <!-- Logo / Circle Initial Avatar -->
        <div class="relative shrink-0 flex-shrink-0" style="z-index:10;">
          <% if (vendor.logo_url) { %>
            <div class="shadow-2xl flex items-center justify-center bg-white" 
                 style="width: 80px; height: 80px; min-width: 80px; border-radius: 50%; overflow: hidden; border: 3px solid rgba(255,255,255,0.4); box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
              <img src="<%= vendor.logo_url %>" alt="<%= vendor.name %> Logo" style="width:100%; height:100%; object-fit:cover; display:block;">
            </div>
          <% } else if (vendor.slug === 'national-packers-movers') { %>
            <div class="bg-gradient-to-br from-amber-400 to-orange-500 text-slate-950 flex flex-col items-center justify-center font-black text-center shadow-2xl" 
                 style="width: 80px; height: 80px; min-width: 80px; border-radius: 50%; border: 3px solid rgba(255,255,255,0.4); box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
              <i class="fa-solid fa-crown text-2xl mb-0.5"></i>
              <span class="text-[8px] uppercase font-extrabold tracking-wider">National</span>
            </div>
          <% } else { %>
            <% const initials = vendor.name.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase(); %>
            <div class="bg-slate-800 text-brand-orange flex items-center justify-center font-bold text-2xl shadow-2xl" 
                 style="width: 80px; height: 80px; min-width: 80px; border-radius: 50%; border: 3px solid rgba(255,255,255,0.2); box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
              <%= initials %>
            </div>
          <% } %>
        </div>

        <!-- Title & Badge Meta Row -->
        <div class="space-y-1.5 pb-1">
          <div class="flex flex-wrap items-center gap-1.5">
            <% if (vendor.status === 'verified') { %>
              <span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[8px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded flex items-center shadow-sm">
                <i class="fa-solid fa-circle-check mr-1 text-xs"></i> Verified Partner
              </span>
            <% } %>
            <% if (vendor.slug === 'national-packers-movers') { %>
              <span class="bg-amber-400 text-slate-950 text-[8px] font-black uppercase tracking-wider px-2 py-0.5 rounded flex items-center shadow-md">
                <i class="fa-solid fa-award mr-1"></i> Certified Brand
              </span>
              <span class="bg-indigo-600 text-white text-[8px] font-black uppercase tracking-wider px-2 py-0.5 rounded flex items-center shadow-md">
                <i class="fa-solid fa-circle-check mr-1"></i> Claimed
              </span>
            <% } else { %>
              <span class="bg-slate-700/60 text-slate-300 text-[8px] font-bold uppercase tracking-wider px-2 py-0.5 rounded">
                <%= vendor.status === 'verified' ? 'Claimed Listing' : 'Unclaimed Listing' %>
              </span>
            <% } %>
          </div>
          
          <h1 class="text-xl sm:text-3xl font-extrabold tracking-tight text-white leading-tight" style="margin:0;">
            <% if (vendor.slug === 'national-packers-movers') { %>
              National Packers <span class="text-brand-orange">&amp;</span> Movers
            <% } else { %>
              <%= vendor.name %>
            <% } %>
          </h1>
          
          <% if (vendor.slug === 'national-packers-movers') { %>
            <p class="text-[9px] sm:text-xs font-bold uppercase tracking-widest text-slate-400 mt-0.5" style="letter-spacing: 0.12em;">
              Trusted Since <%= vendor.year_founded || 1987 %> <span class="mx-1.5 text-slate-600">|</span> All India Service
            </p>
          <% } %>

          <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1 text-xs text-slate-300 font-semibold" style="margin-top: 4px;">
            <span class="flex items-center"><i class="fa-solid fa-location-dot text-brand-orange mr-1.5"></i> <%= city.name %>, India</span>
            <% if (vendor.year_founded && vendor.slug !== 'national-packers-movers') { %>
              <span class="flex items-center"><i class="fa-solid fa-calendar mr-1.5 text-indigo-400"></i> Est. <%= vendor.year_founded %></span>
            <% } %>
            <% if (vendor.slug === 'national-packers-movers') { %>
              <span class="flex items-center text-amber-400 font-bold"><i class="fa-solid fa-circle-check mr-1"></i> IBA Approved Relocation Network</span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Quick Ratings Box -->
      <div class="flex items-center gap-4 bg-slate-950/50 border border-slate-800 backdrop-blur-md px-5 py-4 rounded-2xl shrink-0 w-fit">
        <div class="flex items-center justify-center bg-emerald-600 text-white font-extrabold text-lg px-3 py-1 rounded-xl shadow-md">
          <span class="mr-1.5"><%= vendor.rating %></span>
          <i class="fa-solid fa-star text-xs text-amber-300"></i>
        </div>
        <div class="border-l border-slate-800 pl-3">
          <div class="flex items-center text-[10px] text-slate-400 font-extrabold uppercase tracking-wider">
            <span>Customer Rating</span>
          </div>
          <p class="text-sm font-bold text-white mt-0.5 hover:underline cursor-pointer" onclick="scrollToSection('section-reviews')"><%= vendor.reviews_count %> Ratings</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sticky Sub-Navigation Tabs (Overview, Photos, Quick Info, Services, Reviews) -->
<div class="sticky-tab-bar shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-14">
      <div id="sub-nav-tabs" class="flex space-x-6 sm:space-x-8 overflow-x-auto py-1 scrollbar-none text-sm font-bold text-slate-600 h-full items-center">
        <button onclick="scrollToSection('section-overview', this)" class="tab-item active-tab pb-2 hover:text-brand-orange transition shrink-0">Overview</button>
        <button onclick="scrollToSection('section-photos', this)" class="tab-item pb-2 hover:text-brand-orange transition shrink-0">Photos</button>
        <button onclick="scrollToSection('section-quickinfo', this)" class="tab-item pb-2 hover:text-brand-orange transition shrink-0">Quick Info</button>
        <button onclick="scrollToSection('section-services', this)" class="tab-item pb-2 hover:text-brand-orange transition shrink-0">Services</button>
        <button onclick="scrollToSection('section-reviews', this)" class="tab-item pb-2 hover:text-brand-orange transition shrink-0">Reviews</button>
        <button onclick="scrollToSection('section-faq', this)" class="tab-item pb-2 hover:text-brand-orange transition shrink-0">FAQs</button>
      </div>

      <!-- Action Button Group on Desktop Header -->
      <div class="hidden lg:flex items-center space-x-3.5">
        <a href="tel:<%= vendor.phone %>" data-vendor-id="<%= vendor.id %>" class="gated-phone-link flex items-center justify-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-md transition duration-150">
          <i class="fa-solid fa-phone"></i> <%= vendor.phone %>
        </a>
        <a href="https://wa.me/91<%= vendor.phone.replace(/[^0-9]/g, '') %>?text=Hello%20<%= encodeURIComponent(vendor.name) %>!%20I%20saw%20your%20profile%20on%20BestPackersMovers%20and%20need%20a%20shifting%20quote." target="_blank" class="flex items-center justify-center gap-1.5 border border-emerald-500 text-emerald-600 hover:bg-emerald-50 font-bold px-4 py-2 rounded-xl text-xs transition duration-150">
          <i class="fa-brands fa-whatsapp text-sm"></i> WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Main Body Section -->
<div class="py-10 bg-slate-50 min-h-[600px] pb-24 lg:pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="vendor-main-container flex flex-col lg:flex-row gap-8 items-start">
      
      <!-- LEFT Details Column -->
      <div class="vendor-left-column w-full lg:w-2/3 space-y-8 flex-shrink-0">
        
        <!-- SECTION 1: Overview & About -->
        <div id="section-overview" class="scroll-mt-32 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-6">
          <div>
            <h2 class="text-xl font-extrabold text-slate-900 flex items-center">
              <i class="fa-solid fa-circle-info text-brand-orange mr-3"></i>
              <span>Company Overview</span>
            </h2>
            <div class="w-12 h-1 bg-brand-orange rounded-full mt-2"></div>
          </div>
          
          <p class="text-sm text-slate-600 leading-relaxed font-medium">
            <%= aboutText %>
          </p>

          <!-- Key Insights Panel (What users liked / Highlights) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <!-- Positives Likes -->
            <div class="bg-emerald-50/50 border border-emerald-100 rounded-2xl p-5 space-y-3 shadow-inner">
              <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-700 flex items-center">
                <i class="fa-solid fa-thumbs-up mr-2 text-sm text-emerald-600"></i> What Users Liked
              </h4>
              <ul class="space-y-2 text-xs text-slate-600 font-semibold">
                <li class="flex items-start"><i class="fa-solid fa-check text-emerald-500 mr-2 mt-0.5"></i> Safe and secure household goods loading</li>
                <li class="flex items-start"><i class="fa-solid fa-check text-emerald-500 mr-2 mt-0.5"></i> Transparent transit pricing with zero hidden surcharges</li>
                <li class="flex items-start"><i class="fa-solid fa-check text-emerald-500 mr-2 mt-0.5"></i> Prompt support & tracking updates during moves</li>
              </ul>
            </div>
            
            <!-- Key Badges Insights -->
            <div class="bg-indigo-50/50 border border-indigo-100 rounded-2xl p-5 space-y-3 shadow-inner">
              <h4 class="text-xs font-bold uppercase tracking-wider text-indigo-700 flex items-center">
                <i class="fa-solid fa-shield-check mr-2 text-sm text-indigo-600"></i> Verified Information
              </h4>
              <ul class="space-y-2 text-xs text-slate-600 font-semibold">
                <li class="flex items-start"><i class="fa-solid fa-shield mr-2 mt-0.5 text-indigo-500"></i> GSTIN Registry Status: Verified Claims</li>
                <li class="flex items-start"><i class="fa-solid fa-shield mr-2 mt-0.5 text-indigo-500"></i> Relocation networks: PAN-India Operations</li>
                <li class="flex items-start"><i class="fa-solid fa-shield mr-2 mt-0.5 text-indigo-500"></i> Support Availability: 6 Days Operations</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- SECTION 2: Media Photo Gallery (Interactive Tab Filters) -->
        <div id="section-photos" class="scroll-mt-32 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
            <div>
              <h2 class="text-xl font-extrabold text-slate-900 flex items-center">
                <i class="fa-solid fa-images text-indigo-600 mr-3"></i>
                <span>Media Catalog</span>
              </h2>
              <div class="w-12 h-1 bg-indigo-500 rounded-full mt-2"></div>
            </div>

            <!-- Gallery Filter Buttons -->
            <div class="flex bg-slate-100 p-1 rounded-xl w-fit text-xs font-bold">
              <button onclick="filterGallery('all', this)" class="gallery-filter-btn px-3 py-1.5 rounded-lg bg-white text-brand-orange shadow-sm">All</button>
              <button onclick="filterGallery('owner', this)" class="gallery-filter-btn px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900">By Owner</button>
              <button onclick="filterGallery('user', this)" class="gallery-filter-btn px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900">By Customers</button>
            </div>
          </div>

          <!-- Photo Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            <% vendorGallery.forEach((img, idx) => { %>
              <% 
                const isLogo = (img.caption && img.caption.toLowerCase().includes('logo')) || 
                               (img.image_url && img.image_url.toLowerCase().includes('logo'));
              %>
              <div class="gallery-item-wrapper hidden group relative aspect-video rounded-2xl overflow-hidden border border-slate-200 cursor-pointer shadow-sm hover:shadow-md transition bg-slate-950" data-uploaded-by="<%= img.uploaded_by || 'owner' %>">
                <img src="<%= img.image_url %>" alt="<%= img.caption || 'Gallery Image' %>" 
                     class="gallery-thumb w-full h-full group-hover:scale-105 transition-transform duration-300" 
                     style="<%= isLogo ? 'object-fit: contain; background: #0f172a;' : 'object-fit: cover;' %>"
                     data-full="<%= img.image_url %>" data-caption="<%= img.caption || '' %>">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent flex items-end p-3">
                  <span class="text-[10px] font-bold text-white truncate"><%= img.caption || 'Relocation Asset' %></span>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Gallery Pagination Controls (v2.9) -->
          <div id="gallery-pagination" class="flex justify-between items-center pt-4 border-t border-slate-100 hidden">
            <button id="gallery-prev-btn" onclick="changeGalleryPage(-1)" class="flex items-center justify-center w-9 h-9 rounded-xl border border-slate-200 hover:bg-slate-50 transition text-slate-600 disabled:opacity-30 disabled:pointer-events-none">
              <i class="fa-solid fa-chevron-left text-xs"></i>
            </button>
            <span id="gallery-page-info" class="text-xs font-bold text-slate-500">Page 1 of 1</span>
            <button id="gallery-next-btn" onclick="changeGalleryPage(1)" class="flex items-center justify-center w-9 h-9 rounded-xl border border-slate-200 hover:bg-slate-50 transition text-slate-600 disabled:opacity-30 disabled:pointer-events-none">
              <i class="fa-solid fa-chevron-right text-xs"></i>
            </button>
          </div>
        </div>

        <!-- SECTION 3: Quick Info Grid -->
        <div id="section-quickinfo" class="scroll-mt-32 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-6">
          <div>
            <h2 class="text-xl font-extrabold text-slate-900 flex items-center">
              <i class="fa-solid fa-list-check text-brand-orange mr-3"></i>
              <span>Quick Information</span>
            </h2>
            <div class="w-12 h-1 bg-brand-orange rounded-full mt-2"></div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm font-semibold">
            <!-- Year Est -->
            <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-200/50">
              <span class="text-slate-400">Year of Establishment</span>
              <span class="text-slate-800 font-extrabold"><%= vendor.year_founded || 1997 %></span>
            </div>
            
            <!-- Timing status -->
            <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-200/50">
              <span class="text-slate-400">Working Hours</span>
              <span class="text-emerald-600 font-extrabold flex items-center"><i class="fa-solid fa-circle-check text-[10px] mr-1.5"></i> Open Now</span>
            </div>
            
            <!-- IBA Badge -->
            <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-200/50">
              <span class="text-slate-400">IBA Approved Relocation</span>
              <span class="text-slate-800 font-extrabold"><%= vendor.slug === 'national-packers-movers' ? 'Yes (Registry Verified)' : 'Verification Pending' %></span>
            </div>

            <!-- GSTIN Registry -->
            <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-200/50">
              <span class="text-slate-400">GST Registration Status</span>
              <span class="text-slate-800 font-extrabold"><%= vendor.slug === 'national-packers-movers' ? 'GSTIN Active' : 'Claims Verified' %></span>
            </div>
          </div>
        </div>

        <!-- SECTION 4: Services Offered Checklist -->
        <div id="section-services" class="scroll-mt-32 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-6">
          <div>
            <h2 class="text-xl font-extrabold text-slate-900 flex items-center">
              <i class="fa-solid fa-truck-fast text-indigo-600 mr-3"></i>
              <span>Services Offered</span>
            </h2>
            <div class="w-12 h-1 bg-indigo-500 rounded-full mt-2"></div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% 
              const serviceList = (vendor.services || 'Household Shifting, Office Relocation, Local Shifting, Packing & Unpacking')
                .split(',')
                .map(s => s.trim())
                .filter(Boolean);
              serviceList.forEach(service => {
            %>
              <div class="flex items-center space-x-3 p-3.5 bg-slate-50/50 border border-slate-200/40 rounded-2xl text-slate-700 font-bold text-sm shadow-sm hover:border-indigo-500/20 hover:bg-indigo-50/10 transition">
                <div class="w-6 h-6 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs">
                  <i class="fa-solid fa-check"></i>
                </div>
                <span><%= service %></span>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- SECTION 5: Reviews Carousel & Post Card -->
        <div id="section-reviews" class="scroll-mt-32 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
            <div>
              <h2 class="text-xl font-extrabold text-slate-900 flex items-center">
                <i class="fa-solid fa-comments text-indigo-600 mr-3"></i>
                <span>Customer Feedback</span>
              </h2>
              <div class="w-12 h-1 bg-indigo-500 rounded-full mt-2"></div>
            </div>
            
            <div id="reviews-login-status" class="text-xs font-bold text-slate-500">
              <!-- JS Populated -->
            </div>
          </div>

          <!-- Overall breakdown widget side-by-side -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 bg-slate-50 p-6 rounded-3xl border border-slate-200/50 items-center">
            <!-- Avg Circle -->
            <div class="text-center space-y-1">
              <span class="text-4xl font-extrabold text-slate-900 block"><%= vendor.rating %></span>
              <div class="flex justify-center text-amber-500 text-xs">
                <% for(let i=1; i<=5; i++) { %>
                  <i class="fa-<%= i <= Math.round(vendor.rating) ? 'solid' : 'regular' %> fa-star"></i>
                <% } %>
              </div>
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block mt-1"><%= vendor.reviews_count %> ratings total</span>
            </div>

            <!-- Distribution slide lists -->
            <div class="md:col-span-2 space-y-2 text-xs font-bold text-slate-600">
              <div class="flex items-center gap-3">
                <span class="w-12">5 Star</span>
                <div class="ratings-breakdown-bar flex-grow">
                  <div class="ratings-breakdown-fill" style="width: 82%;"></div>
                </div>
                <span class="w-8 text-right">82%</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-12">4 Star</span>
                <div class="ratings-breakdown-bar flex-grow">
                  <div class="ratings-breakdown-fill" style="width: 14%;"></div>
                </div>
                <span class="w-8 text-right">14%</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-12">3 Star</span>
                <div class="ratings-breakdown-bar flex-grow">
                  <div class="ratings-breakdown-fill" style="width: 3%;"></div>
                </div>
                <span class="w-8 text-right">3%</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-12">2 Star</span>
                <div class="ratings-breakdown-bar flex-grow">
                  <div class="ratings-breakdown-fill" style="width: 1%;"></div>
                </div>
                <span class="w-8 text-right">1%</span>
              </div>
            </div>
          </div>

          <!-- Slider component -->
          <div class="premium-reviews-section relative w-full py-8 px-6 rounded-3xl overflow-hidden mb-6">
            <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/5 rounded-full blur-3xl pointer-events-none"></div>

            <div class="text-center space-y-2 mb-8 relative z-10">
              <div class="flex items-center justify-center gap-3 text-[9px] font-extrabold uppercase tracking-widest text-brand-orange">
                <span class="w-8 h-px bg-brand-orange/30"></span>
                <span>CUSTOMER REVIEWS</span>
                <span class="w-8 h-px bg-brand-orange/30"></span>
              </div>
              <h2 class="text-xl sm:text-2xl font-extrabold text-white">What Shifting Clients Say</h2>
            </div>

            <% if (reviews.length === 0) { %>
              <div class="text-center py-12 text-slate-400 text-xs font-semibold relative z-10">
                No reviews yet. Be the first to publish details!
              </div>
            <% } else { %>
              <div class="relative px-8 sm:px-14 min-h-[160px] flex items-center justify-center z-10">
                <% if (reviews.length > 1) { %>
                  <button type="button" onclick="manualChangeSlide(-1)" class="review-nav-btn absolute left-0 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full flex items-center justify-center active:scale-95" aria-label="Previous Slide">
                    <i class="fa-solid fa-chevron-left text-sm"></i>
                  </button>
                <% } %>

                <div class="w-full">
                  <% reviews.forEach((review, idx) => { %>
                    <div class="review-slide-card transition-all duration-500 <%= idx === 0 ? 'block' : 'hidden' %>" data-slide-index="<%= idx %>" style="opacity: <%= idx === 0 ? '1' : '0' %>;">
                      <div class="space-y-4">
                        <div class="flex items-center text-amber-400 text-xs space-x-1.5">
                          <% for(let i=1; i<=5; i++) { %>
                            <i class="fa-<%= i <= review.rating ? 'solid' : 'regular' %> fa-star"></i>
                          <% } %>
                        </div>
                        <div class="max-h-[160px] overflow-y-auto pr-1 space-y-2">
                          <p class="review-quote-text">"<%= review.review_text %>"</p>

                          <% if (review.admin_reply) { %>
                            <div class="bg-indigo-950/80 border border-indigo-500/30 rounded-xl p-3 text-xs space-y-1 text-left mt-2">
                              <div class="flex items-center text-brand-orange font-bold text-[10px] uppercase tracking-wider">
                                <i class="fa-solid fa-reply mr-1.5"></i> Response from Business Owner
                              </div>
                              <p class="text-slate-200 font-medium text-xs"><%= review.admin_reply %></p>
                            </div>
                          <% } %>
                        </div>
                        <div class="flex items-center space-x-3 pt-3" style="border-top: 1px solid rgba(51, 65, 85, 0.3);">
                          <div class="w-8 h-8 rounded-full text-white flex items-center justify-center font-black text-xs shadow-md shrink-0 bg-gradient-to-br from-amber-400 to-orange-500">
                            <%= review.customer_name.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase() %>
                          </div>
                          <div>
                            <h4 class="review-client-name"><%= review.customer_name %></h4>
                            <p class="review-client-title"><%= city.name %> Shifting Client</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>

                <% if (reviews.length > 1) { %>
                  <button type="button" onclick="manualChangeSlide(1)" class="review-nav-btn absolute right-0 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full flex items-center justify-center active:scale-95" aria-label="Next Slide">
                    <i class="fa-solid fa-chevron-right text-sm"></i>
                  </button>
                <% } %>
              </div>

              <% if (reviews.length > 1) { %>
                <div class="flex justify-center items-center space-x-2 mt-6 pt-4 border-t border-slate-800/30">
                  <% reviews.forEach((_, idx) => { %>
                    <button type="button" onclick="manualGoToSlide(<%= idx %>)" class="review-dot-indicator <%= idx === 0 ? 'active' : '' %>" data-dot-index="<%= idx %>" aria-label="Go to slide <%= idx + 1 %>"></button>
                  <% }) %>
                </div>
              <% } %>
            <% } %>
          </div>

          <!-- Verified Reviews Feed List (Full List View with Admin Replies) -->
          <% if (reviews && reviews.length > 0) { %>
            <div class="space-y-4 pt-4 border-t border-slate-100">
              <h3 class="font-extrabold text-slate-800 text-sm flex items-center">
                <i class="fa-solid fa-comments text-brand-orange mr-2"></i> Verified Customer Testimonials (<%= reviews.length %>)
              </h3>
              
              <div class="space-y-4 max-h-[400px] overflow-y-auto pr-2">
                <% reviews.forEach(rev => { %>
                  <div class="bg-slate-50 border border-slate-200/60 rounded-2xl p-4 space-y-2.5">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center space-x-2">
                        <div class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 text-white font-black text-[10px] flex items-center justify-center">
                          <%= rev.customer_name.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase() %>
                        </div>
                        <div>
                          <h4 class="text-xs font-bold text-slate-800 leading-tight"><%= rev.customer_name %></h4>
                          <div class="flex items-center text-amber-400 text-[10px] space-x-0.5">
                            <% for(let i=1; i<=5; i++) { %>
                              <i class="fa-<%= i <= rev.rating ? 'solid' : 'regular' %> fa-star"></i>
                            <% } %>
                          </div>
                        </div>
                      </div>
                      <span class="text-[10px] text-slate-400 font-semibold">
                        <%= rev.created_at ? new Date(rev.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '' %>
                      </span>
                    </div>

                    <p class="text-xs text-slate-600 font-medium leading-relaxed">"<%= rev.review_text %>"</p>

                    <!-- Official Admin Reply Badge -->
                    <% if (rev.admin_reply) { %>
                      <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3 text-xs space-y-1 mt-2">
                        <div class="flex items-center text-indigo-700 font-extrabold text-[10px] uppercase tracking-wider">
                          <i class="fa-solid fa-reply mr-1.5 text-brand-orange"></i> Official Response from Owner
                        </div>
                        <p class="text-slate-700 font-medium text-xs leading-normal"><%= rev.admin_reply %></p>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- Write or Edit Review Box -->
          <form id="review-form" class="bg-slate-50 p-6 rounded-3xl border border-slate-200/50 space-y-4">
            <div class="flex items-center justify-between">
