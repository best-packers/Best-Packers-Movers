<div class="topbar">
  <h2><i class="fa-solid fa-comments" style="color:var(--accent);margin-right:8px;"></i> Reviews Manager</h2>
  <button onclick="openSeedModal()" class="btn btn-primary">
    <i class="fa-solid fa-plus"></i> Seed Customer Review
  </button>
</div>

<div class="content">

  <!-- Reviews List Card -->
  <div class="card">
    <div class="card-title">All Customer Reviews</div>
    
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Customer</th>
            <th>Rating</th>
            <th>Listing / City</th>
            <th>Review Comment</th>
            <th>Date</th>
            <th style="text-align:right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (reviews.length === 0) { %>
            <tr>
              <td colspan="6" style="text-align:center;color:#64748b;padding:24px;">
                No reviews found in database. Use the button above to seed verified reviews.
              </td>
            </tr>
          <% } else { %>
            <% reviews.forEach(review => { %>
              <tr id="review-row-<%= review.id %>">
                <td>
                  <div style="font-weight:700;color:var(--text);"><%= review.customer_name %></div>
                  <div style="font-size:10px;color:var(--muted);"><%= review.phone || 'Anonymous / Guest' %></div>
                </td>
                <td>
                  <div style="color:var(--accent);font-weight:700;">
                    <%= review.rating %> ★
                  </div>
                </td>
                <td>
                  <% if (review.vendor_id === 0) { %>
                    <div style="font-weight:600;color:var(--accent2);">National Packers &amp; Movers</div>
                    <div style="font-size:10px;color:var(--muted);"><%= review.city_name || 'All Cities' %></div>
                  <% } else { %>
                    <div style="font-weight:600;"><%= review.vendor_name %></div>
                    <div style="font-size:10px;color:var(--muted);"><%= review.city_name %></div>
                  <% } %>
                </td>
                <td style="max-width:300px;font-size:12px;line-height:1.5;">
                  <%= review.review_text %>
                </td>
                <td style="font-size:11px;color:var(--muted);white-space:nowrap;">
                  <%= new Date(review.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </td>
                <td style="text-align:right;white-space:nowrap;">
                  <button onclick="openReplyModal(<%= review.id %>, '<%= (review.customer_name || '').replace(/'/g, "\\'") %>', '<%= (review.admin_reply || '').replace(/'/g, "\\'").replace(/\n/g, ' ') %>')" class="btn" style="background:rgba(99,102,241,0.1);color:#6366f1;border:1px solid rgba(99,102,241,0.2);padding:6px 12px;font-size:11px;margin-right:6px;">
                    <i class="fa-solid fa-reply"></i> <%= review.admin_reply ? 'Edit Reply' : 'Reply' %>
                  </button>
                  <button onclick="deleteReview(<%= review.id %>)" class="btn" style="background:rgba(239,68,68,0.1);color:#ef4444;border:1px solid rgba(239,68,68,0.2);padding:6px 12px;font-size:11px;">
                    <i class="fa-solid fa-trash"></i> Delete
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Seed Review Modal -->
<div id="seed-modal" class="modal-backdrop" style="position:fixed;inset:0;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);z-index:9999;display:none;align-items:center;justify-content:center;padding:16px;">
  <div class="card" style="max-width:550px;width:100%;background:#1e293b;border-color:var(--border);">
    <div class="card-title" style="display:flex;justify-content:between;align-items:center;border-bottom:1px solid var(--border);padding-bottom:12px;margin-bottom:16px;">
      <span>Seed 5-Star Customer Review</span>
      <button onclick="closeSeedModal()" class="btn" style="background:none;color:var(--muted);padding:0;"><i class="fa-solid fa-xmark text-lg"></i></button>
    </div>

    <form id="seed-review-form" onsubmit="submitSeedReview(event)">
      <div class="form-row" style="grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
        <div>
          <label for="seed_state">Select State</label>
          <select id="seed_state" onchange="filterCitiesForSeed()" required style="width:100%;">
            <option value="">-- State --</option>
            <% states.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="seed_city">Select City</label>
          <select id="seed_city" onchange="filterVendorsForSeed()" required style="width:100%;">
            <option value="">-- City --</option>
          </select>
        </div>
      </div>

      <div style="margin-bottom:12px;">
        <label for="seed_vendor">Target Company Profile</label>
        <select id="seed_vendor" name="vendor_id" required style="width:100%;">
          <option value="">-- Select Company --</option>
        </select>
      </div>

      <div class="form-row" style="grid-template-columns:2fr 1fr;gap:12px;margin-bottom:12px;">
        <div>
          <label for="seed_customer">Customer Name</label>
          <input type="text" id="seed_customer" name="customer_name" required placeholder="e.g. Ramesh Kumar">
        </div>
        <div>
          <label for="seed_rating">Rating</label>
          <select id="seed_rating" name="rating" required style="width:100%;">
            <option value="5">5 ★★★★★</option>
            <option value="4">4 ★★★★</option>
            <option value="3">3 ★★★</option>
            <option value="2">2 ★★</option>
            <option value="1">1 ★</option>
          </select>
        </div>
      </div>

      <div style="margin-bottom:18px;">
        <label for="seed_text">Review Description</label>
        <textarea id="seed_text" name="review_text" rows="3" required placeholder="Write a professional shifting experience comment..."></textarea>
      </div>

      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:12px;">
        <i class="fa-solid fa-paper-plane"></i> Publish Seeded Review
      </button>
    </form>
  </div>
</div>

<!-- Reply to Review Modal -->
<div id="reply-modal" class="modal-backdrop" style="position:fixed;inset:0;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);z-index:9999;display:none;align-items:center;justify-content:center;padding:16px;">
  <div class="card" style="max-width:500px;width:100%;background:#1e293b;border-color:var(--border);">
    <div class="card-title" style="display:flex;justify-content:between;align-items:center;border-bottom:1px solid var(--border);padding-bottom:12px;margin-bottom:16px;">
      <span>Write Response from Business Owner</span>
      <button onclick="closeReplyModal()" class="btn" style="background:none;color:var(--muted);padding:0;"><i class="fa-solid fa-xmark text-lg"></i></button>
    </div>

    <form id="reply-review-form" onsubmit="submitAdminReply(event)">
      <input type="hidden" id="reply_review_id">
      <p id="reply-customer-label" style="font-size:12px;color:var(--accent2);margin-bottom:12px;font-weight:600;"></p>
      
      <div style="margin-bottom:18px;">
        <label for="admin_reply_text">Official Reply Message</label>
        <textarea id="admin_reply_text" name="admin_reply" rows="4" required placeholder="Thank the customer for their review, confirm shifting details, or offer support..."></textarea>
      </div>

      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:12px;">
        <i class="fa-solid fa-paper-plane"></i> Publish Official Reply
      </button>
    </form>
  </div>
</div>

<script>
  const citiesMap = <%- JSON.stringify(cities) %>;
  const vendorsMap = <%- JSON.stringify(vendors) %>;

  const stateSel = document.getElementById('seed_state');
  const citySel = document.getElementById('seed_city');
  const vendorSel = document.getElementById('seed_vendor');

  function openSeedModal() {
    document.getElementById('seed-modal').style.display = 'flex';
  }

  function closeSeedModal() {
    document.getElementById('seed-modal').style.display = 'none';
  }

  function openReplyModal(reviewId, customerName, existingReply) {
    document.getElementById('reply_review_id').value = reviewId;
    document.getElementById('reply-customer-label').textContent = `Replying to customer: ${customerName}`;
    document.getElementById('admin_reply_text').value = existingReply || '';
    document.getElementById('reply-modal').style.display = 'flex';
  }

  function closeReplyModal() {
    document.getElementById('reply-modal').style.display = 'none';
  }

  async function submitAdminReply(e) {
    e.preventDefault();
    const reviewId = document.getElementById('reply_review_id').value;
    const admin_reply = document.getElementById('admin_reply_text').value.trim();

    try {
      const res = await fetch(`/admin/reviews/reply/${reviewId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ admin_reply })
      });
      const data = await res.json();
      if (data.success) {
        showToast('Official reply published!');
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast(data.message || 'Reply submission failed.', true);
      }
    } catch(err) {
      showToast('Network error occurred.', true);
    }
  }

  function filterCitiesForSeed() {
    const stateId = stateSel.value;
    citySel.innerHTML = '<option value="">-- City --</option>';
    vendorSel.innerHTML = '<option value="">-- Select Company --</option>';

    if (stateId) {
      const filtered = citiesMap.filter(c => c.state_id == stateId);
      filtered.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.name;
        citySel.appendChild(opt);
      });
    }
  }

  function filterVendorsForSeed() {
    const cityId = citySel.value;
    vendorSel.innerHTML = '<option value="">-- Select Company --</option>';
    
    if (cityId) {
      // 1. Always add National Packers & Movers option as it is PAN India and mapped to vendor id 0
      const natOpt = document.createElement('option');
      natOpt.value = "0";
      natOpt.textContent = "National Packers & Movers (Gold Partner)";
      vendorSel.appendChild(natOpt);

      // 2. Add other local competitors in this city
      const filtered = vendorsMap.filter(v => v.city_id == cityId);
      filtered.forEach(v => {
        const opt = document.createElement('option');
        opt.value = v.id;
        opt.textContent = v.name;
        vendorSel.appendChild(opt);
      });
    }
  }

  // Toast helpers
  function showToast(msg, isErr = false) {
    const toast = document.getElementById('admin-toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.className = isErr ? 'error' : 'success';
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; }, 4000);
  }

  // Add review AJAX
  async function submitSeedReview(e) {
    e.preventDefault();
    const cityId = citySel.value;
    const vendor_id = vendorSel.value;
    const customer_name = document.getElementById('seed_customer').value.trim();
    const rating = document.getElementById('seed_rating').value;
    const review_text = document.getElementById('seed_text').value.trim();

    try {
      const res = await fetch('/admin/reviews/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ vendor_id, city_id: cityId, customer_name, rating, review_text })
      });
      const data = await res.json();
      if (data.success) {
        showToast('Review seeded successfully!');
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast(data.message || 'Seeding failed.', true);
      }
    } catch(err) {
      showToast('Network error occurred.', true);
    }
  }

  // Delete review AJAX
  async function deleteReview(id) {
    if (!confirm('Are you sure you want to delete this customer review? This will recalculate business ratings.')) return;
    try {
      const res = await fetch(`/admin/reviews/delete/${id}`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        showToast('Review deleted successfully!');
        const row = document.getElementById(`review-row-${id}`);
        if (row) row.remove();
      } else {
        showToast(data.message || 'Deletion failed.', true);
      }
    } catch(err) {
      showToast('Network error occurred.', true);
    }
  }
</script>
