<div class="topbar">
  <h2><i class="fa-solid fa-chart-line" style="color:var(--accent);margin-right:8px;"></i> Traffic Analytics</h2>
  <span class="badge"><%= totalVisits %> total page views</span>
</div>
<div class="content" style="display:flex;flex-direction:column;gap:24px;">

  <!-- Stats Grid -->
  <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
    <div class="stat-card">
      <div class="stat-icon orange"><i class="fa-solid fa-eye"></i></div>
      <div>
        <div class="stat-val"><%= totalVisits %></div>
        <div class="stat-label">Total Page Views</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
      <div>
        <div class="stat-val"><%= [...new Set(recentLogs.map(l => l.ip_address))].length %></div>
        <div class="stat-label">Active Users (Recent)</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon green"><i class="fa-solid fa-mobile-screen-button"></i></div>
      <div>
        <div class="stat-val">
          <%= recentLogs.filter(l => l.device_type === 'Mobile').length %> / <%= recentLogs.length %>
        </div>
        <div class="stat-label">Mobile Traffic Ratio</div>
      </div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1.8fr;gap:20px;align-items:start;flex-wrap:wrap;">
    
    <!-- Top Pages Card -->
    <div class="card">
      <div class="card-title">Top Visited Pages</div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Page URL</th>
              <th style="text-align:right;">Views</th>
            </tr>
          </thead>
          <tbody>
            <% if (topPages.length === 0) { %>
              <tr><td colspan="2" style="text-align:center;color:#64748b;padding:16px;">No page views logged yet.</td></tr>
            <% } else { %>
              <% topPages.forEach(page => { %>
                <tr>
                  <td>
                    <a href="<%= page.url %>" target="_blank" style="color:var(--accent);font-weight:600;">
                      <%= page.url %>
                    </a>
                  </td>
                  <td style="text-align:right;font-weight:700;color:var(--accent2);"><%= page.count %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Live Log Stream Card -->
    <div class="card">
      <div class="card-title">Live Visitor Stream (Last 50 Visits)</div>
      <div class="table-wrap" style="max-height:550px;overflow-y:auto;">
        <table>
          <thead>
            <tr>
              <th>IP Address</th>
              <th>Page URL</th>
              <th>Device</th>
              <th>Location</th>
              <th>Time</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentLogs.length === 0) { %>
              <tr><td colspan="5" style="text-align:center;color:#64748b;padding:24px;">No visitor data logged yet.</td></tr>
            <% } else { %>
              <% recentLogs.forEach(log => { %>
                <tr>
                  <td>
                    <span style="font-family:monospace;color:var(--muted);font-weight:600;"><%= log.ip_address %></span>
                  </td>
                  <td style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="<%= log.url %>">
                    <a href="<%= log.url %>" target="_blank" style="font-weight:600;"><%= log.url %></a>
                  </td>
                  <td>
                    <% if (log.device_type === 'Mobile') { %>
                      <span title="Mobile" style="color:var(--success);font-size:14px;"><i class="fa-solid fa-mobile-screen-button"></i></span>
                    <% } else if (log.device_type === 'Tablet') { %>
                      <span title="Tablet" style="color:var(--accent);font-size:14px;"><i class="fa-solid fa-tablet-screen-button"></i></span>
                    <% } else { %>
                      <span title="Desktop" style="color:var(--accent2);font-size:14px;"><i class="fa-solid fa-desktop"></i></span>
                    <% } %>
                  </td>
                  <td>
                    <div style="font-weight:600;font-size:12px;">
                      <%= log.city %>, <%= log.state %>
                    </div>
                    <% if (log.locality) { %>
                      <div style="font-size:10px;color:#10b981;font-weight:bold;margin-top:2px;">
                        <i class="fa-solid fa-location-crosshairs" style="margin-right:2px;"></i><%= log.locality %>
                      </div>
                    <% } %>
                    <div style="font-size:10px;color:var(--muted);">
                      <i class="fa-solid fa-earth-asia" style="margin-right:2px;"></i><%= log.country %>
                    </div>
                  </td>
                  <td style="font-size:11px;color:var(--muted);white-space:nowrap;">
                    <%= new Date(log.created_at).toLocaleTimeString('en-IN', {hour: '2-digit', minute:'2-digit', second:'2-digit'}) %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

</div>
