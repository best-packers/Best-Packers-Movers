<%
// Admin Dashboard
%>
<div class="topbar">
  <h2><i class="fa-solid fa-chart-pie" style="color:var(--accent);margin-right:8px;"></i> Dashboard</h2>
  <span class="badge">Admin Panel v2.0</span>
</div>
<div class="content">
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon orange"><i class="fa-solid fa-inbox"></i></div>
      <div><div class="stat-val"><%= stats.leads %></div><div class="stat-label">Total Leads</div></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon blue"><i class="fa-solid fa-building"></i></div>
      <div><div class="stat-val"><%= stats.vendors %></div><div class="stat-label">Vendors Listed</div></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon green"><i class="fa-solid fa-map-location-dot"></i></div>
      <div><div class="stat-val"><%= stats.cities %></div><div class="stat-label">Cities Covered</div></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon red"><i class="fa-solid fa-pen-nib"></i></div>
      <div><div class="stat-val"><%= stats.blogs %></div><div class="stat-label">Published Blogs</div></div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Recent Lead Inquiries</div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Phone</th>
            <th>From</th>
            <th>To</th>
            <th>Moving Date</th>
            <th>Received At</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentLeads.length === 0) { %>
            <tr><td colspan="6" style="text-align:center;color:#64748b;padding:24px;">No leads yet. They will appear here when customers submit quote requests.</td></tr>
          <% } else { %>
            <% recentLeads.forEach((lead, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><strong>+91 <%= lead.phone %></strong></td>
                <td><%= lead.moving_from %></td>
                <td><%= lead.moving_to %></td>
                <td><%= lead.moving_date || '—' %></td>
                <td><%= new Date(lead.created_at).toLocaleString('en-IN') %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
    <div style="margin-top:14px;">
      <a href="/admin/leads" class="btn btn-secondary btn-sm">
        <i class="fa-solid fa-list"></i> View All Leads
      </a>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-top:20px;">
    <a href="/admin/leads" class="card" style="display:flex;align-items:center;gap:12px;cursor:pointer;transition:border-color .15s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
      <div class="stat-icon orange"><i class="fa-solid fa-inbox"></i></div>
      <div><div style="font-weight:700;font-size:13px;">Manage Leads</div><div style="font-size:11px;color:var(--muted)">View all quote requests</div></div>
    </a>
    <a href="/admin/vendors" class="card" style="display:flex;align-items:center;gap:12px;cursor:pointer;transition:border-color .15s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
      <div class="stat-icon blue"><i class="fa-solid fa-building"></i></div>
      <div><div style="font-weight:700;font-size:13px;">Manage Vendors</div><div style="font-size:11px;color:var(--muted)">Update logos, banners, about</div></div>
    </a>
    <a href="/admin/gallery" class="card" style="display:flex;align-items:center;gap:12px;cursor:pointer;transition:border-color .15s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
      <div class="stat-icon green"><i class="fa-solid fa-images"></i></div>
      <div><div style="font-weight:700;font-size:13px;">Manage Gallery</div><div style="font-size:11px;color:var(--muted)">Upload photos per city/vendor</div></div>
    </a>
    <a href="/admin/blogs" class="card" style="display:flex;align-items:center;gap:12px;cursor:pointer;transition:border-color .15s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
      <div class="stat-icon red"><i class="fa-solid fa-pen-nib"></i></div>
      <div><div style="font-weight:700;font-size:13px;">Write Blog Post</div><div style="font-size:11px;color:var(--muted)">Add & publish articles</div></div>
    </a>
    <a href="/admin/seo" class="card" style="display:flex;align-items:center;gap:12px;cursor:pointer;transition:border-color .15s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
      <div class="stat-icon blue"><i class="fa-solid fa-magnifying-glass-chart"></i></div>
      <div><div style="font-weight:700;font-size:13px;">SEO Manager</div><div style="font-size:11px;color:var(--muted)">Edit meta titles & descriptions</div></div>
    </a>
  </div>
</div>
