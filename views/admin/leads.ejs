<div class="topbar">
  <h2><i class="fa-solid fa-inbox" style="color:var(--accent);margin-right:8px;"></i> Lead Inquiries</h2>
  <span class="badge">Page <%= page %> of <%= totalPages %></span>
</div>
<div class="content">
  <div class="card">
    <div class="card-title">All Quote Requests</div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Phone</th>
            <th>Moving From</th>
            <th>Moving To</th>
            <th>Moving Date</th>
            <th>Vendor Contacted</th>
            <th>Received At</th>
          </tr>
        </thead>
        <tbody>
          <% if (leads.length === 0) { %>
            <tr><td colspan="7" style="text-align:center;color:#64748b;padding:30px;">No lead inquiries yet.</td></tr>
          <% } else { %>
            <% leads.forEach((lead, i) => { %>
              <tr>
                <td style="color:var(--muted)"><%= ((page-1)*20) + i + 1 %></td>
                <td>
                  <a href="tel:+91<%= lead.phone %>" style="color:var(--success);font-weight:700;">
                    <i class="fa-solid fa-phone" style="margin-right:4px;"></i>+91 <%= lead.phone %>
                  </a>
                </td>
                <td><i class="fa-solid fa-location-dot" style="color:var(--accent);margin-right:4px;font-size:11px;"></i><%= lead.moving_from %></td>
                <td><i class="fa-solid fa-location-dot" style="color:var(--accent2);margin-right:4px;font-size:11px;"></i><%= lead.moving_to %></td>
                <td><%= lead.moving_date ? new Date(lead.moving_date).toLocaleDateString('en-IN') : '<span style="color:#64748b;">Flexible</span>' %></td>
                <td>
                  <% if (lead.vendor_name) { %>
                    <span class="badge-success"><%= lead.vendor_name %></span>
                  <% } else { %>
                    <span class="badge-warning">National Packers</span>
                  <% } %>
                </td>
                <td style="color:var(--muted);font-size:11px;"><%= new Date(lead.created_at).toLocaleString('en-IN') %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div style="display:flex;gap:10px;margin-top:16px;align-items:center;">
        <% if (page > 1) { %>
          <a href="/admin/leads?page=<%= page - 1 %>" class="btn btn-secondary btn-sm"><i class="fa-solid fa-chevron-left"></i> Previous</a>
        <% } %>
        <span style="font-size:12px;color:var(--muted);">Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="/admin/leads?page=<%= page + 1 %>" class="btn btn-secondary btn-sm">Next <i class="fa-solid fa-chevron-right"></i></a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
