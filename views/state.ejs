<!-- State Directory View -->
<div class="bg-slate-900 text-white py-16 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-tr from-brand-orange/5 to-transparent pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <nav class="flex space-x-2 text-xs font-semibold text-slate-400 mb-3">
          <a href="/" class="hover:text-white transition">Home</a>
          <span>/</span>
          <span class="text-brand-orange">States</span>
        </nav>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
          Packers & Movers in <span class="text-brand-orange"><%= state.name %></span>
        </h1>
        <p class="text-slate-400 mt-2 text-sm sm:text-base max-w-xl">
          Browse verified relocation companies, local shifting rates, and reviews across major cities in <%= state.name %>.
        </p>
      </div>

      <!-- Live Search Bar -->
      <div class="bg-white/10 border border-white/15 px-4 py-2.5 rounded-xl flex items-center max-w-sm w-full">
        <i class="fa-solid fa-magnifying-glass text-slate-400 mr-3"></i>
        <input type="text" id="city-search" oninput="filterCities()" placeholder="Search city in <%= state.name %>..." class="bg-transparent text-sm w-full text-white placeholder-slate-400 focus:outline-none">
      </div>
    </div>
  </div>
</div>

<div class="py-16 bg-slate-50 min-h-[500px]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl p-8 border border-slate-200/60 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center">
        <i class="fa-solid fa-tree-city text-indigo-600 mr-2.5"></i>
        <span>Available City Directories (<%= cities.length %> Cities)</span>
      </h2>

      <% if (cities.length === 0) { %>
        <div class="text-center py-12">
          <i class="fa-solid fa-folder-open text-slate-300 text-4xl mb-4"></i>
          <p class="text-slate-500 font-semibold">No directories seeded for this state yet.</p>
        </div>
      <% } else { %>
        <div id="city-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          <% cities.forEach(city => { %>
            <a href="/<%= city.slug %>" class="city-card bg-slate-50 border border-slate-200/60 hover:border-brand-orange hover:shadow-md hover:bg-white rounded-xl p-5 group transition-all flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <div class="w-10 h-10 bg-indigo-50 border border-indigo-100 text-indigo-600 group-hover:bg-orange-50 group-hover:border-orange-100 group-hover:text-brand-orange rounded-lg flex items-center justify-center transition-all">
                  <i class="fa-solid fa-city text-sm"></i>
                </div>
                <div>
                  <h3 class="font-bold text-slate-800 group-hover:text-brand-orange transition-colors"><%= city.name %></h3>
                  <p class="text-xs text-slate-400 font-semibold">Relocation Guide</p>
                </div>
              </div>
              <i class="fa-solid fa-arrow-right-long text-slate-300 group-hover:text-brand-orange group-hover:translate-x-1 transition-all"></i>
            </a>
          <% }) %>
        </div>
      <% } %>

      <!-- Programmatic SEO State Insights (Premium Card Layout) -->
      <% if (state.seo_text) { %>
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/60 shadow-sm mt-8 space-y-4">
          <h2 class="text-xl font-extrabold text-slate-900 flex items-center border-b border-slate-100 pb-3">
            <i class="fa-solid fa-circle-info text-indigo-600 mr-2.5"></i>
            <span>Relocating in <%= state.name %>: Shifting Insights &amp; Guidelines</span>
          </h2>
          <div class="text-slate-600 text-sm leading-relaxed space-y-3 font-medium">
            <%- state.seo_text %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  function filterCities() {
    const query = document.getElementById('city-search').value.toLowerCase();
    const cards = document.querySelectorAll('.city-card');
    
    cards.forEach(card => {
      const cityName = card.querySelector('h3').textContent.toLowerCase();
      if (cityName.includes(query)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }
</script>
