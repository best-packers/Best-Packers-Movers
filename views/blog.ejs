<div class="bg-slate-900 text-white">
  <!-- Blog Hero -->
  <div class="relative py-16 sm:py-20 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-orange-500 rounded-full filter blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-500 rounded-full filter blur-3xl"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-brand-orange bg-orange-500/10 border border-orange-500/20 px-3 py-1 rounded-full mb-4">Relocation Knowledge Hub</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">Shifting Tips &<br class="hidden sm:block"> Relocation Guides</h1>
      <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto">Expert advice on household moves, office relocations, packing techniques, and everything you need to know about shifting in India.</p>
    </div>
  </div>

  <!-- Category Filter Tabs -->
  <div class="sticky top-16 z-20 bg-slate-900/95 backdrop-blur-sm border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 overflow-x-auto">
      <div class="flex gap-1 py-3 min-w-max">
        <a href="/blog" class="px-4 py-2 rounded-lg text-xs font-bold transition <%= selectedCategory === 'all' ? 'bg-brand-orange text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>">All Articles</a>
        <% categories.forEach(cat => { %>
          <a href="/blog?category=<%= encodeURIComponent(cat) %>" class="px-4 py-2 rounded-lg text-xs font-bold transition whitespace-nowrap <%= selectedCategory === cat ? 'bg-brand-orange text-white' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>"><%= cat %></a>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<!-- Blog Grid -->
<div class="bg-slate-50 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if (blogs.length === 0) { %>
      <div class="text-center py-20">
        <i class="fa-solid fa-pen-nib text-slate-300 text-5xl mb-4 block"></i>
        <h2 class="text-xl font-bold text-slate-500">No articles yet</h2>
        <p class="text-slate-400 mt-2">Check back soon — we're writing helpful content for your shifting journey.</p>
        <a href="/" class="mt-6 inline-block bg-brand-orange text-white px-6 py-3 rounded-xl font-bold hover:bg-orange-600 transition">Find Movers Near You</a>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% blogs.forEach((blog, i) => { %>
          <article class="bg-white rounded-2xl overflow-hidden border border-slate-200 hover:border-brand-orange/40 hover:shadow-lg hover:shadow-orange-500/10 transition-all group flex flex-col">
            <a href="/blog/<%= blog.slug %>" class="block">
              <% if (blog.cover_image_url) { %>
                <div class="h-48 overflow-hidden">
                  <img src="<%= blog.cover_image_url %>" alt="<%= blog.title %>"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="<%= i < 3 ? 'eager' : 'lazy' %>">
                </div>
              <% } else { %>
                <div class="h-48 bg-gradient-to-br from-orange-500/20 to-slate-200 flex items-center justify-center">
                  <i class="fa-solid fa-newspaper text-4xl text-orange-300"></i>
                </div>
              <% } %>
            </a>
            <div class="p-5 flex flex-col flex-grow space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-bold uppercase tracking-wider text-brand-orange bg-orange-50 px-2 py-0.5 rounded-md"><%= blog.category || 'Guide' %></span>
                <span class="text-[10px] text-slate-400 font-medium">
                  <% if (blog.read_time_mins) { %><i class="fa-regular fa-clock mr-1"></i><%= blog.read_time_mins %> min<% } %>
                </span>
              </div>
              <h2 class="text-sm font-bold text-slate-900 leading-snug flex-grow">
                <a href="/blog/<%= blog.slug %>" class="hover:text-brand-orange transition-colors"><%= blog.title %></a>
              </h2>
              <p class="text-xs text-slate-500 leading-relaxed line-clamp-2"><%= blog.excerpt %></p>
              <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                <span class="text-[10px] text-slate-400"><%= new Date(blog.created_at).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></span>
                <a href="/blog/<%= blog.slug %>" class="inline-flex items-center text-xs font-bold text-brand-orange hover:text-orange-600 transition">
                  Read Article <i class="fa-solid fa-arrow-right ml-1 text-[10px]"></i>
                </a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- Quote CTA Footer Banner -->
<div class="bg-brand-orange py-12">
  <div class="max-w-4xl mx-auto px-4 text-center text-white">
    <h2 class="text-2xl font-extrabold mb-2">Ready to Plan Your Move?</h2>
    <p class="text-orange-100 mb-6">Get free shifting quotes from verified packers & movers across India.</p>
    <button class="open-quote-btn bg-white text-brand-orange font-bold px-8 py-3.5 rounded-xl hover:bg-orange-50 transition shadow-md" data-vendor-id="0" data-vendor-name="National Packers & Movers">
      <i class="fa-solid fa-file-invoice mr-2"></i> Get Free Quote Now
    </button>
  </div>
</div>

<!-- Schema.org for Blog Listing -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "BestPackersMovers — Shifting Tips & Guides",
  "description": "Expert advice on household shifting, office relocation, and packing tips for India.",
  "url": "<%= canonicalUrl %>"
}
</script>
